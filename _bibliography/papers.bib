@article{lee2026jmst_plif_dye,
  abbr         = {JMST},
    bibtex_show  = {true},
      selected     = {true},
        title        = {Optical characterization of pyrromethene dyes as seeded tracer for fuel PLIF in high temperature},
          author       = {Lee, Hyunchang},
            journal      = jmst,
              volume       = {40},
                number       = {1},
                  pages        = {749--759},
                    year         = {2026},
                      doi          = {10.1007/s12206-025-1262-6},
                        url          = {https://doi.org/10.1007/s12206-025-1262-6},
                          abstract     = {Accurate measurement of liquid fuel distribution is essential for optimizing injector design in liquid-fueled engines. This study investigated a pyrromethene-based fluorescent dye dissolved in exoTHDCPD as a candidate for use as a seeded tracer for PLIF diagnostics. The dyes were optically characterized using a 532 nm CW laser. Fluorescence spectra and intensities were measured in a heated cuvette setup using a spectrometer and sCMOS camera. Among the tested dyes, pyrromethene 567 exhibited nearly five times the signal intensity of the reference up to 160 degC. Using pyrromethene 567 with a 2.15 W CW laser and a 0.2 ms exposure time, the model estimates a measurement precision better than 1 percent under a beam height of 9.8 mm and thickness of 0.25 mm.}
                          }

                          @article{lee2025ijhmt_2c2d_lif,
                            abbr         = {IJHMT},
                              bibtex_show  = {true},
                                selected     = {true},
                                  title        = {Uncertainty measurement of two color two dye laser-induced fluorescence thermometry and application thereof to superheated liquid jet},
                                    author       = {Lee, Hyunchang},
                                      journal      = ijhmt,
                                        volume       = {244},
                                          pages        = {126908},
                                            year         = {2025},
                                              doi          = {10.1016/j.ijheatmasstransfer.2025.126908},
                                                url          = {https://doi.org/10.1016/j.ijheatmasstransfer.2025.126908},
                                                  abstract     = {Flash boiling spray is highly interesting in various industries, and bubble generation and growth by phase change and heat transfer in a metastable state governs the development of the spray. In this experimental study, the performance of thermometry using fluorescein disodium and sulforhodamine was evaluated using a jet of water at various injection temperatures from 25 to 84.5 degC. The measured precision was around 2 percent over 60 degC. The temperature fields of superheated liquid jet disintegration regimes were measured and their physical plausibility discussed.}
                                                  }

